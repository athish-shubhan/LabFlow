# For running the API / tests on the host against the compose Postgres. Copy to backend/.env.
DATABASE_URL=postgresql+psycopg://labflow:change-me@localhost:5432/labflow
TEST_DATABASE_URL=postgresql+psycopg://labflow:change-me@localhost:5432/labflow_test
JWT_SECRET=replace-with-a-long-random-string-of-32-plus-chars
CORS_ORIGINS=["http://localhost:3000"]
