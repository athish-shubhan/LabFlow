# Copy to .env and replace the placeholders. Read by docker compose.
POSTGRES_USER=labflow
POSTGRES_PASSWORD=change-me
POSTGRES_DB=labflow
POSTGRES_PORT=5432
BACKEND_PORT=8000
FRONTEND_PORT=3000

# At least 32 characters. Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=replace-with-a-long-random-string-of-32-plus-chars

# Load synthetic demo data on backend start (idempotent).
SEED_DEMO_DATA=true
